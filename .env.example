# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/nutriologo_db?schema=public"

# Docker Database Config (usado por docker-compose)
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=nutriologo_db
DB_PORT=5432

# ============================================
# NEXTAUTH / AUTHENTICATION
# ============================================
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-random-secret-key-in-production"

# Confiar en el host para testing local de producción
# En producción real, cambiar NEXTAUTH_URL al dominio real y quitar esta línea
AUTH_TRUST_HOST=true

# ============================================
# REDIS / BULL QUEUE
# ============================================
REDIS_URL="redis://:redis123@localhost:6379"
REDIS_PASSWORD=redis123
REDIS_PORT=6379

# ============================================
# GOOGLE CALENDAR API
# ============================================
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google-calendar/callback"

# ============================================
# TWILIO WHATSAPP
# ============================================
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"
TWILIO_WEBHOOK_SECRET="your-webhook-secret"

# ============================================
# EMAIL NOTIFICATIONS (Resend)
# ============================================
# Envío de correos al nutriólogo. El correo DESTINO y qué avisos recibir se
# configuran desde la UI (/configuracion/notificaciones). La API key y el
# remitente son internos y se definen aquí.

# API key de Resend. Obtener en https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Correo remitente (FROM). Debe pertenecer a un dominio verificado en Resend.
# Si no se define, usa notificaciones@nutricionpaulcortez.com
RESEND_FROM_EMAIL="notificaciones@nutricionpaulcortez.com"

# (Opcional) Correo destino por defecto, como fallback si no se define en la UI.
NUTRIOLOGO_EMAIL="nutriologo@ejemplo.com"

# ============================================
# NOTIFICACIONES POR WHATSAPP AL NUTRIÓLOGO (opcional)
# ============================================
# Número de WhatsApp del nutriólogo para recibir notificaciones
# Formato: whatsapp:+521234567890
NUTRIOLOGO_WHATSAPP="whatsapp:+5219511301554"

# Habilitar notificaciones por WhatsApp (true/false)
NOTIFICACIONES_WHATSAPP_ENABLED="false"

# ============================================
# PLANTILLAS APROBADAS DE META (Content SIDs)
# ============================================
# Configura como 'true' para usar plantillas aprobadas en producción
# Configura como 'false' para usar mensajes libres en sandbox
USE_APPROVED_TEMPLATES="false"

# Plantillas de citas (existentes)
TEMPLATE_CONFIRMACION_SID="HXxxxxxxxxxxxxxxxxx"
TEMPLATE_RECORDATORIO_24H_SID="HXxxxxxxxxxxxxxxxxx"
TEMPLATE_RECORDATORIO_1H_SID="HXxxxxxxxxxxxxxxxxx"
TEMPLATE_SEGUIMIENTO_SID="HXxxxxxxxxxxxxxxxxx"

# Nuevas plantillas de seguimiento post-consulta
TEMPLATE_SEGUIMIENTO_INICIAL_SID="HXxxxxxxxxxxxxxxxxx"
TEMPLATE_SEGUIMIENTO_INTERMEDIO_SID="HXxxxxxxxxxxxxxxxxx"
TEMPLATE_SEGUIMIENTO_PREVIO_CITA_SID="HXxxxxxxxxxxxxxxxxx"
TEMPLATE_RECORDATORIO_AGENDAR_SID="HXxxxxxxxxxxxxxxxxx"

# ============================================
# FILE STORAGE
# ============================================
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="10485760"
# 10MB en bytes

# ============================================
# UPSTASH REDIS (Rate Limiting)
# ============================================
# Crear cuenta gratuita en https://upstash.com
# Crear base de datos Redis y copiar las credenciales
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-token"
# Nota: Si no configuras Upstash, el rate limiting usará Map en memoria (solo desarrollo)

# ============================================
# OPENAI / IA ASSISTANT
# ============================================
# API Key de OpenAI (obtener en: https://platform.openai.com/api-keys)
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxx"

# Modelo a usar (gpt-4o, gpt-4o-mini, gpt-4-turbo)
# Recomendado: gpt-4o para respuestas inteligentes
OPENAI_MODEL="gpt-4o"

# Temperatura (0.0-1.0): Mayor = más creativo, Menor = más predecible
OPENAI_TEMPERATURE="0.7"

# Máximo de tokens por respuesta (mayor = respuestas más largas)
OPENAI_MAX_TOKENS="500"

# Umbral de confianza (0.0-1.0): Mínimo para responder automáticamente
# Si la confianza es menor, deriva a humano
AI_CONFIDENCE_THRESHOLD="0.7"

# Habilitar/deshabilitar IA (true/false)
AI_ENABLED="true"

# ============================================
# APP CONFIGURATION
# ============================================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Nombre del sitio (title/SEO). Por cliente al desplegar. Fallback: "Nutrición Paul Cortes"
NEXT_PUBLIC_NOMBRE_SITIO="Nutrición Paul Cortes"
APP_PORT=3000

# ============================================
# PRODUCTION SETTINGS (comentado para desarrollo)
# ============================================
# NODE_ENV="production"
# NEXT_PUBLIC_APP_URL="https://nutricionpaulcortez.com"
# NEXTAUTH_URL="https://nutricionpaulcortez.com"
# GOOGLE_REDIRECT_URI="https://nutricionpaulcortez.com/api/google-calendar/callback"
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# ============================================
# SENTRY (Monitoreo de Errores)
# ============================================
# Obtener DSN de https://sentry.io
# El mismo DSN se usa para servidor y cliente
SENTRY_DSN="https://xxxxx@oxxxxx.ingest.us.sentry.io/xxxxx"
NEXT_PUBLIC_SENTRY_DSN="https://xxxxx@oxxxxx.ingest.us.sentry.io/xxxxx"

# ============================================
# LOGGING
# ============================================
# Niveles: error, warn, info, debug
LOG_LEVEL="info"

# ============================================
# OBJECT STORAGE (S3-compatible: Cloudflare R2, DO Spaces, AWS S3, MinIO)
# ============================================
# Si NO se configuran, los archivos se guardan en disco local (uploads/).
# Configúralas para almacenar archivos en object storage (recomendado en prod).
S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
S3_BUCKET="nutriologo-archivos"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="auto"
# Prefijo opcional por cliente (si varios clientes comparten un bucket)
S3_PREFIX=""
