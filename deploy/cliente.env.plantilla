# ============================================================
# Configuración de un cliente (plantilla)
# ============================================================
# El script deploy/nuevo-cliente.sh copia este archivo a
# deploy/clientes/<cliente>.env y rellena los valores marcados con {{...}}.
# Estos archivos generados NO se suben a git (contienen secretos).

# --- Identidad del cliente ---
CLIENTE={{CLIENTE}}
DOMINIO={{DOMINIO}}
NEXT_PUBLIC_APP_URL=https://{{DOMINIO}}
NEXTAUTH_URL=https://{{DOMINIO}}
AUTH_TRUST_HOST=true
NEXTAUTH_SECRET={{NEXTAUTH_SECRET}}
# Nombre del sitio (título del navegador / SEO). El nombre del consultorio que
# ven los pacientes en las páginas también se edita desde la UI del cliente.
NEXT_PUBLIC_NOMBRE_SITIO={{NOMBRE_SITIO}}

# --- Base de datos (Neon, una por cliente) ---
DATABASE_URL={{DATABASE_URL}}

# --- Redis propio del cliente (aislamiento total de caché y colas) ---
REDIS_URL=redis://{{CLIENTE}}-redis:6379

# --- Object storage (archivos del cliente) ---
# Bucket compartido, carpeta aislada por cliente vía S3_PREFIX.
S3_ENDPOINT={{S3_ENDPOINT}}
S3_BUCKET={{S3_BUCKET}}
S3_ACCESS_KEY={{S3_ACCESS_KEY}}
S3_SECRET_KEY={{S3_SECRET_KEY}}
S3_REGION=auto
S3_PREFIX={{CLIENTE}}

# --- WhatsApp (Twilio, número propio por cliente) ---
TWILIO_ACCOUNT_SID={{TWILIO_ACCOUNT_SID}}
TWILIO_AUTH_TOKEN={{TWILIO_AUTH_TOKEN}}
TWILIO_WHATSAPP_NUMBER={{TWILIO_WHATSAPP_NUMBER}}
USE_APPROVED_TEMPLATES=true

# --- Google Calendar (app compartida; cada cliente autoriza la suya en la UI) ---
GOOGLE_CLIENT_ID={{GOOGLE_CLIENT_ID}}
GOOGLE_CLIENT_SECRET={{GOOGLE_CLIENT_SECRET}}
GOOGLE_REDIRECT_URI=https://{{DOMINIO}}/api/google-calendar/callback

# --- IA (OpenAI, key compartida) ---
OPENAI_API_KEY={{OPENAI_API_KEY}}
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=500
AI_CONFIDENCE_THRESHOLD=0.7
AI_ENABLED=true

# --- Email (Resend, key compartida; destino se pone en la UI del cliente) ---
RESEND_API_KEY={{RESEND_API_KEY}}
RESEND_FROM_EMAIL={{RESEND_FROM_EMAIL}}

# --- Monitoreo (compartido) ---
SENTRY_DSN={{SENTRY_DSN}}
NEXT_PUBLIC_SENTRY_DSN={{SENTRY_DSN}}
LOG_LEVEL=info
NODE_ENV=production
