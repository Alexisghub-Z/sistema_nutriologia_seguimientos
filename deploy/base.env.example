# ============================================================
# Secretos COMPARTIDOS entre todos los clientes
# ============================================================
# Copia este archivo a deploy/base.env y rellena los valores.
# deploy/base.env NO se sube a git.
# El script nuevo-cliente.sh toma estos valores para cada cliente.

# Object storage (un bucket para todos; se aísla por carpeta S3_PREFIX=cliente)
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_BUCKET=nutriologo-archivos
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Google Calendar: UNA app de Google Cloud para todos los clientes
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# OpenAI: una key para todos
OPENAI_API_KEY=sk-xxxx

# Resend: una key para todos (el correo destino lo pone cada cliente en su UI)
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=notificaciones@tudominio.com

# Sentry (opcional, monitoreo compartido)
SENTRY_DSN=
